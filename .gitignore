# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# =========================
# Virtual environments
# =========================
.venv/
.venv-1/
venv/
env/
ENV/

# =========================
# Environment variables / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# OS / editor files
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Jupyter / cache
# =========================
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================
# Raw and processed data
# Avoid committing restricted/large data files
# Keep only transparent methodology/config files
# =========================
data/raw/*
!data/raw/protective_intelligence_decision_rules.csv
data/processed/

# =========================
# Generated tables
# Avoid committing generated CSV model outputs
# =========================
outputs/tables/

# =========================
# Optional generated local files
# =========================
*.log
*.tmp

# =========================
# Keep portfolio-facing outputs
# =========================
!outputs/

# Charts
!outputs/charts/
!outputs/charts/*.png

# Maps
!outputs/maps/
!outputs/maps/*.html

# Reports
!outputs/reports/
!outputs/reports/*.pdf

# Country profiles generated under reports
!outputs/reports/country_profiles/
!outputs/reports/country_profiles/*.md
!outputs/reports/country_profiles/*.csv

# Screenshots
!outputs/screenshots/
!outputs/screenshots/*.png

# Legacy / alternate country profile location
!outputs/country_profiles/
!outputs/country_profiles/*.md
!outputs/country_profiles/*.csv